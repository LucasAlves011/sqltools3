#include "OpenEditor\OpenEditorInc.rc"
#include "RES\VersionInfo.rc"
#include "PropTree.rc"

// Atualizacoes: dialogos "Update Available" e "What's New" (Update/UpdateManager.cpp)
IDD_UPDATE_AVAILABLE DIALOGEX 0, 0, 330, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Update Available"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_UPD_HEADER,10,10,310,24
    LTEXT           "What's new:",-1,10,38,100,8
    EDITTEXT        IDC_UPD_NOTES,10,50,310,114,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Nothing is installed automatically. ""Download"" opens the release page in your browser, where you can download the new version.",-1,10,170,310,18
    DEFPUSHBUTTON   "&Download",IDOK,100,196,70,14
    PUSHBUTTON      "&Skip This Version",IDC_UPD_SKIP,175,196,75,14
    PUSHBUTTON      "Remind Me &Later",IDCANCEL,255,196,65,14
END

IDD_CHANGELOG DIALOGEX 0, 0, 360, 270
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "What's New"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "English",IDC_CHL_FLAG_EN,294,5,26,16,BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Portugues (Brasil)",IDC_CHL_FLAG_PT,324,5,26,16,BS_OWNERDRAW | WS_TABSTOP
    EDITTEXT        IDC_CHL_TEXT,10,26,340,198,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Check for updates when SQLTools starts",IDC_CHL_AUTOCHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,250,170,10
    PUSHBUTTON      "Check for &Updates",IDC_CHL_CHECK,205,247,75,14
    DEFPUSHBUTTON   "&Close",IDOK,285,247,65,14
END

IDR_CHANGELOG           RCDATA                  "..\\CHANGELOG.md"
// historico em portugues (Brasil): a ferramenta continua em ingles, so o What's New tem os dois idiomas
IDR_CHANGELOG_PT        RCDATA                  "..\\CHANGELOG.pt-BR.md"
// icones das bandeiras do What's New (flag-icons, licenca MIT: res\flags\LICENSE-flag-icons.txt)
IDR_FLAG_US             RCDATA                  "res\\flags\\us.png"
IDR_FLAG_BR             RCDATA                  "res\\flags\\br.png"

// icones dos botoes do painel Valor (gerados por tools/GenToolbarIcons)
IDB_VALUE_ICONS         BITMAP                  "res\\ValuePanelIcons.bmp"

// icones da Lista de objetos (tipos e botoes), gerados por tools/GenToolbarIcons
IDB_OBJLIST_ICONS      BITMAP                  "res\\ObjectListIcons.bmp"

// icones dos paineis Output, Estatisticas e Plano (mesma ordem de pane_list.bmp)
IDB_PANE_ICONS32       BITMAP                  "res\\PaneIcons.bmp"

// icones dos botoes do dialogo Connect (gerados por tools/GenToolbarIcons)
IDB_DIALOG_ICONS       BITMAP                  "res\\DialogIcons.bmp"

// icones da janela de cursor (peek) do editor, gerados por tools/GenToolbarIcons
IDB_PEEK_ICONS         BITMAP                  "res\\PeekIcons.bmp"

